+Dictionary VoxelTerrain::_validate_mesh_block_render_coverage_claims(Vector3i block_pos, String world_id,
+		Array claims) const {
+	static constexpr int SECTION_SIZE_CELLS = 16;
+	static constexpr int MAX_COVERAGE_CLAIMS = 64;
+	Dictionary result;
+	result["status"] = "failed";
+	if (world_id.is_empty()) {
+		result["reason"] = "render_coverage_world_id_empty";
+		return result;
+	}
+	if (get_mesh_block_size() != SECTION_SIZE_CELLS) {
+		result["reason"] = "render_coverage_mesh_block_size_mismatch";
+		result["expectedBlockSize"] = SECTION_SIZE_CELLS;
+		result["actualBlockSize"] = get_mesh_block_size();
+		return result;
+	}
+	if (claims.size() > MAX_COVERAGE_CLAIMS) {
+		result["reason"] = "render_coverage_claim_limit_exceeded";
+		return result;
+	}
+
+	const int64_t block_min[3] = {
+		static_cast<int64_t>(block_pos.x) * SECTION_SIZE_CELLS,
+		static_cast<int64_t>(block_pos.y) * SECTION_SIZE_CELLS,
+		static_cast<int64_t>(block_pos.z) * SECTION_SIZE_CELLS
+	};
+	StdVector<uint8_t> covered(SECTION_SIZE_CELLS * SECTION_SIZE_CELLS * SECTION_SIZE_CELLS, 0);
+	Array normalized_claims;
+	Array owner_ids;
+	Array section_keys;
+
+	for (int64_t i = 0; i < claims.size(); ++i) {
+		const Variant claim_value = claims[i];
+		if (claim_value.get_type() != Variant::DICTIONARY) {
+			result["reason"] = "render_coverage_claim_not_dictionary";
+			return result;
+		}
+		const Dictionary claim = claim_value;
+		const String claim_world_id = String(claim.get("worldId", String()));
+		const String slot_owner_id = String(claim.get("slotOwnerId", String()));
+		const String source_revision = String(claim.get("sourceRevision", String()));
+		const String receipt_digest = String(claim.get("receiptDigest", String()));
+		const int64_t section_generation = int64_t(claim.get("sectionGeneration", int64_t(0)));
+		const Variant section_key_value = claim.get("sectionKey", Variant());
+		if (claim_world_id != world_id || slot_owner_id.is_empty() || source_revision.is_empty() ||
+				receipt_digest.is_empty() || section_generation <= 0 ||
+				section_key_value.get_type() != Variant::VECTOR3I) {
+			result["reason"] = "render_coverage_claim_identity_invalid";
+			return result;
+		}
+		const Vector3i section_key = section_key_value;
+		if (owner_ids.has(slot_owner_id) || section_keys.has(section_key)) {
+			result["reason"] = "render_coverage_claim_duplicate_owner_or_section";
+			return result;
+		}
+		owner_ids.append(slot_owner_id);
+		section_keys.append(section_key);
+
+		const int64_t section_min[3] = {
+			static_cast<int64_t>(section_key.x) * SECTION_SIZE_CELLS,
+			static_cast<int64_t>(section_key.y) * SECTION_SIZE_CELLS,
+			static_cast<int64_t>(section_key.z) * SECTION_SIZE_CELLS
+		};
+		int64_t low[3];
+		int64_t high[3];
+		const int64_t block_max[3] = {
+			block_min[0] + SECTION_SIZE_CELLS,
+			block_min[1] + SECTION_SIZE_CELLS,
+			block_min[2] + SECTION_SIZE_CELLS
+		};
+		bool intersects = true;
+		for (int axis = 0; axis < 3; ++axis) {
+			low[axis] = MAX(block_min[axis], section_min[axis]);
+			high[axis] = MIN(block_max[axis], section_min[axis] + SECTION_SIZE_CELLS);
+			if (low[axis] >= high[axis]) intersects = false;
+		}
+		if (!intersects) {
+			result["reason"] = "render_coverage_section_outside_mesh_block";
+			return result;
+		}
+		for (int64_t z = low[2]; z < high[2]; ++z) {
+			for (int64_t y = low[1]; y < high[1]; ++y) {
+				for (int64_t x = low[0]; x < high[0]; ++x) {
+					const size_t index = static_cast<size_t>(
+							((z - block_min[2]) * SECTION_SIZE_CELLS + (y - block_min[1])) *
+							SECTION_SIZE_CELLS + (x - block_min[0]));
+					covered[index] = 1;
+				}
+			}
+		}
+		Dictionary normalized_claim = claim.duplicate(true);
+		normalized_claim.make_read_only();
+		normalized_claims.append(normalized_claim);
+	}
+
+	bool coverage_complete = true;
+	for (const uint8_t cell_covered : covered) {
+		if (cell_covered == 0) {
+			coverage_complete = false;
+			break;
+		}
+	}
+	normalized_claims.make_read_only();
+	result["status"] = "ready";
+	result["coverageComplete"] = coverage_complete;
+	result["claims"] = normalized_claims;
+	return result;
+}
+
+Dictionary VoxelTerrain::_b_replace_mesh_block_render_coverage(Vector3i block_pos, int64_t terrain_instance_id,
+		int64_t owner_generation,
+		int64_t expected_coverage_revision, String world_id, Array claims) {
+	Dictionary result;
+	result["status"] = "failed";
+	VoxelMeshBlockVT *block = _mesh_map.get_block(block_pos);
+	if (block == nullptr) {
+		result["status"] = "pending";
+		result["reason"] = "render_coverage_mesh_block_not_present";
+		return result;
+	}
+	if (terrain_instance_id <= 0 || static_cast<int64_t>(get_instance_id()) != terrain_instance_id) {
+		result["reason"] = "render_coverage_terrain_instance_stale";
+		return result;
+	}
+	if (owner_generation <= 0 || block->owner_generation != owner_generation) {
+		result["reason"] = "render_coverage_mesh_block_generation_stale";
+		result["currentOwnerGeneration"] = block->owner_generation;
+		return result;
+	}
+	if (expected_coverage_revision < 0 || block->render_coverage_revision != expected_coverage_revision) {
+		result["reason"] = "render_coverage_revision_stale";
+		result["currentCoverageRevision"] = block->render_coverage_revision;
+		return result;
+	}
+	if (block->render_coverage_revision == std::numeric_limits<int64_t>::max()) {
+		result["reason"] = "render_coverage_revision_exhausted";
+		return result;
+	}
+	const Dictionary validation = _validate_mesh_block_render_coverage_claims(block_pos, world_id, claims);
+	if (String(validation.get("status", String())) != "ready") return validation;
+
+	block->render_coverage_claims = validation["claims"];
+	block->render_coverage_complete = bool(validation["coverageComplete"]);
+	++block->render_coverage_revision;
+	block->set_visible(block->render_viewers.get() > 0 && !block->render_coverage_complete);
+	result["status"] = "ready";
+	result["coverageComplete"] = block->render_coverage_complete;
+	result["renderSuppressed"] = block->render_coverage_complete;
+	result["ownerGeneration"] = block->owner_generation;
+	result["coverageRevision"] = block->render_coverage_revision;
+	result["claimCount"] = block->render_coverage_claims.size();
+	return result;
+}
+
+Dictionary VoxelTerrain::_b_remove_mesh_block_render_coverage_claim(Vector3i block_pos, int64_t terrain_instance_id,
+		int64_t owner_generation,
+		int64_t expected_coverage_revision, String world_id, String slot_owner_id,
+		int64_t section_generation, Vector3i section_key, String source_revision, String receipt_digest) {
+	Dictionary result;
+	result["status"] = "failed";
+	VoxelMeshBlockVT *block = _mesh_map.get_block(block_pos);
+	if (block == nullptr) {
+		result["status"] = "pending";
+		result["reason"] = "render_coverage_mesh_block_not_present";
+		return result;
+	}
+	if (terrain_instance_id <= 0 || static_cast<int64_t>(get_instance_id()) != terrain_instance_id) {
+		result["reason"] = "render_coverage_terrain_instance_stale";
+		return result;
+	}
+	if (owner_generation <= 0 || block->owner_generation != owner_generation) {
+		result["reason"] = "render_coverage_mesh_block_generation_stale";
+		return result;
+	}
+	if (expected_coverage_revision < 0 || block->render_coverage_revision != expected_coverage_revision) {
+		result["reason"] = "render_coverage_revision_stale";
+		result["currentCoverageRevision"] = block->render_coverage_revision;
+		return result;
+	}
+	if (block->render_coverage_revision == std::numeric_limits<int64_t>::max()) {
+		result["reason"] = "render_coverage_revision_exhausted";
+		return result;
+	}
+	Array remaining_claims;
+	bool removed = false;
+	for (int64_t i = 0; i < block->render_coverage_claims.size(); ++i) {
+		const Dictionary claim = block->render_coverage_claims[i];
+		const bool matches = String(claim.get("worldId", String())) == world_id &&
+				String(claim.get("slotOwnerId", String())) == slot_owner_id &&
+				int64_t(claim.get("sectionGeneration", int64_t(0))) == section_generation &&
+				claim.get("sectionKey", Vector3i()) == section_key &&
+				String(claim.get("sourceRevision", String())) == source_revision &&
+				String(claim.get("receiptDigest", String())) == receipt_digest;
+		if (matches) {
+			removed = true;
+		} else {
+			remaining_claims.append(claim);
+		}
+	}
+	if (!removed) {
+		result["reason"] = "render_coverage_exact_claim_not_current";
+		return result;
+	}
+	const Dictionary validation = _validate_mesh_block_render_coverage_claims(block_pos, world_id, remaining_claims);
+	if (String(validation.get("status", String())) != "ready") return validation;
+	block->render_coverage_claims = validation["claims"];
+	block->render_coverage_complete = bool(validation["coverageComplete"]);
+	++block->render_coverage_revision;
+	block->set_visible(block->render_viewers.get() > 0 && !block->render_coverage_complete);
+	result["status"] = "ready";
+	result["removed"] = true;
+	result["coverageComplete"] = block->render_coverage_complete;
+	result["renderSuppressed"] = block->render_coverage_complete;
+	result["ownerGeneration"] = block->owner_generation;
+	result["coverageRevision"] = block->render_coverage_revision;
+	result["claimCount"] = block->render_coverage_claims.size();
+	return result;
+}
