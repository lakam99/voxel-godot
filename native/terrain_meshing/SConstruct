#!/usr/bin/env python

import os
import subprocess

godot_cpp_dir = os.environ.get("GODOT_CPP_DIR", "godot-cpp")
if not os.path.exists(os.path.join(godot_cpp_dir, "SConstruct")):
    raise RuntimeError("Missing godot-cpp bindings. Set GODOT_CPP_DIR or run node tools/build-native-terrain-meshing.mjs --fetch-godot-cpp.")
with open("godot-cpp-revision.txt", encoding="utf-8") as revision_file:
    required_revision = revision_file.read().strip()
actual_revision = subprocess.check_output(["git", "-C", godot_cpp_dir, "rev-parse", "HEAD"], text=True).strip()
if actual_revision != required_revision:
    raise RuntimeError("godot-cpp revision mismatch; use the revision in godot-cpp-revision.txt")

env = SConscript(os.path.join(godot_cpp_dir, "SConstruct"))
env = env.Clone()
env.Append(CPPPATH=["src"])
env.Append(CXXFLAGS=["/O2"] if env["platform"] == "windows" and env.get("is_msvc", False) else ["-O2"])

env.VariantDir("build", "src", duplicate=0)
sources = Glob("build/*.cpp")
kernel_env = env.Clone()
kernel_env.Append(CXXFLAGS=["/fp:strict"] if env["platform"] == "windows" and env.get("is_msvc", False) else ["-ffp-contract=off"])
kernel_sources = [source for source in sources if str(source).endswith("building_support_kernel.cpp")]
sources = [source for source in sources if source not in kernel_sources]
sources += kernel_env.SharedObject(kernel_sources)
target_name = "terrain_meshing_backend{}{}".format(env["suffix"], env["SHLIBSUFFIX"])
library = env.SharedLibrary(os.path.join("bin", target_name), source=sources)

Default(library)
