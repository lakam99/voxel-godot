{
  "schemaVersion": 1,
  "runners": [
    {
      "id": "npc_focused",
      "description": "All focused NPC suites implemented up to the active phase",
      "command": ".\\tools\\npc\\run-all-npc-tests.ps1",
      "args": ["-TimeMode", "Both", "-Seed", "atlas-1492"],
      "required": true
    },
    {
      "id": "npc_observation_dusk",
      "description": "Phase 09 dusk return-home observation evidence",
      "command": ".\\tools\\npc\\run-npc-observation-tests.ps1",
      "args": ["-Scenario", "DuskReturnHome", "-TimeMode", "Transition", "-Seed", "atlas-1492", "-ReportPath", "artifacts\\test-runners\\npc-observation-dusk.json"],
      "reportPath": "artifacts\\test-runners\\npc-observation-dusk.json",
      "required": true
    },
    {
      "id": "npc_observation_midnight",
      "description": "Phase 09 midnight guard/interior observation evidence",
      "command": ".\\tools\\npc\\run-npc-observation-tests.ps1",
      "args": ["-Scenario", "MidnightTown", "-TimeMode", "Night", "-Seed", "atlas-1492", "-ReportPath", "artifacts\\test-runners\\npc-observation-midnight.json"],
      "reportPath": "artifacts\\test-runners\\npc-observation-midnight.json",
      "required": true
    },
    {
      "id": "npc_observation_phase12",
      "description": "Phase 12 noon, dusk, midnight, dawn, crowded-door, shared-door, and dynamic-repair observation evidence",
      "command": ".\\tools\\npc\\run-npc-observation-tests.ps1",
      "args": ["-Scenario", "All", "-TimeMode", "Both", "-Seed", "atlas-1492", "-ReportPath", "artifacts\\test-runners\\npc-observation-phase12.json"],
      "reportPath": "artifacts\\test-runners\\npc-observation-phase12.json",
      "required": true
    },
    {
      "id": "world_signature",
      "description": "Deterministic world signature comparison",
      "command": ".\\tools\\run-world-signature.ps1",
      "args": ["-OutputPath", "artifacts\\test-runners\\world-signature-atlas-1492.json", "-Seed", "atlas-1492"],
      "reportPath": "artifacts\\test-runners\\world-signature-atlas-1492.json",
      "required": true
    },
    {
      "id": "visual_manifest",
      "description": "Generated visual manifest validation",
      "command": "node",
      "args": [".\\tools\\art\\validate-visual-manifest.mjs"],
      "required": true
    },
    {
      "id": "npc_navigation_integration",
      "description": "Dedicated NPC navigation integration regression runner",
      "command": ".\\tools\\run-npc-navigation-tests.ps1",
      "args": ["-ReportPath", "artifacts\\test-runners\\npc-navigation-report.json", "-Seed", "atlas-1492"],
      "reportPath": "artifacts\\test-runners\\npc-navigation-report.json",
      "required": true
    },
    {
      "id": "story_playtest",
      "description": "Story continuity playtest",
      "command": ".\\tools\\story\\run-story-playtest.ps1",
      "args": ["-ReportPath", "artifacts\\test-runners\\story-playtest-report.json", "-Seed", "atlas-1492"],
      "reportPath": "artifacts\\test-runners\\story-playtest-report.json",
      "required": true
    },
    {
      "id": "visual_captures",
      "description": "Visual capture generation and metadata validation",
      "command": ".\\tools\\run-visual-captures.ps1",
      "args": ["-OutputDir", "artifacts\\test-runners\\visual", "-Seed", "atlas-1492"],
      "reportPath": "artifacts\\test-runners\\visual\\visual-captures.json",
      "required": true
    },
    {
      "id": "playtest",
      "description": "Broad gameplay continuity playtest",
      "command": ".\\tools\\run-playtest.ps1",
      "args": ["-ReportPath", "artifacts\\test-runners\\playtest-report.json", "-Seed", "atlas-1492"],
      "reportPath": "artifacts\\test-runners\\playtest-report.json",
      "required": true
    }
  ]
}
