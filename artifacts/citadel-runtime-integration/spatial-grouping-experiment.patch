diff --git a/scripts/buildings/BuildingSpatialGroups.gd b/scripts/buildings/BuildingSpatialGroups.gd
new file mode 100644
index 0000000..ec8e37a
--- /dev/null
+++ b/scripts/buildings/BuildingSpatialGroups.gd
@@ -0,0 +1,43 @@
+extends RefCounted
+## Presentation indexing only. Crossing source parts keep one physical owner.
+const TERRAIN_CELLS := 32
+const CELL_METRES := 43.2
+const MAX_DEFERRED_INSTANCES := 262144
+
+static func world_frame(parent: Node3D) -> Transform3D:
+	# Detached diagnostic roots have only their local coordinate frame.
+	return parent.global_transform if parent.is_inside_tree() else parent.transform
+
+static func completion_index(blueprint, frame: Transform3D, continuation: Callable = Callable()) -> Dictionary:
+	var last: Dictionary = {}
+	for i in blueprint.parts.size():
+		if i%128==0 and continuation.is_valid() and continuation.call("publication_spatial_index")!=true: return {}
+		var part = blueprint.parts[i]
+		if part!=null and String(part.kind)!="door":
+			last[owner_cell(frame*part.position)] = i
+	last.make_read_only()
+	var completions: Array = last.values()
+	completions.sort()
+	completions.make_read_only()
+	var result := {"frame":frame,"last":last,"completions":completions}
+	result.make_read_only()
+	return result
+
+static func owner_cell(world_position: Vector3) -> Vector2i:
+	return Vector2i(floori(world_position.x/CELL_METRES),floori(world_position.z/CELL_METRES))
+
+static func key(cell: Vector2i, material: Material) -> String:
+	return "%d,%d:box:%d" % [cell.x,cell.y,material.get_instance_id()]
+
+static func create_group(cell: Vector2i, material: Material) -> Dictionary:
+	return {"ownerCell":cell,"material":material,"transforms":[],"customData":[],
+		"sourceSpans":[],"bounds":AABB(),"hasBounds":false}
+
+static func include(group: Dictionary, part_id: String, first: int, count: int, bounds: AABB) -> void:
+	group.bounds = group.bounds.merge(bounds) if group.hasBounds else bounds
+	group.hasBounds = true
+	var spans: Array = group.sourceSpans
+	if not spans.is_empty() and spans[-1].partId==part_id and spans[-1].first+spans[-1].count==first:
+		spans[-1].count += count
+	else:
+		spans.append({"partId":part_id,"first":first,"count":count})
