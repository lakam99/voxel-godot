+func spatial_submission_parity(original: GDScript) -> void:
+	var parent := Node3D.new(); root.add_child(parent)
+	parent.position = Vector3(-4500,0,-3590)
+	parent.rotation.y = 0.3
+	var old_parent := Node3D.new(); root.add_child(old_parent)
+	old_parent.transform = parent.transform
+	var old = original.new()
+	var current := RecordingPublisher.new()
+	old.source_blueprint_id="spatial"; current.source_blueprint_id="spatial"
+	var expected: Dictionary = {}
+	var owners: Dictionary = {}
+	for index in 3:
+		var part := Part.new({"id":"beam_"+str(index),"kind":"beam","material":"wood",
+			"position":Vector3(-50+index*60,2,0),"size":Vector3(100,0.4,0.4),"rotation":Vector3(0,0.2,0)})
+		var before: Dictionary = {}
+		for key in old.static_visual_batches: before[key]=old.static_visual_batches[key].transforms.size()
+		old.publish_static_part(part,old_parent)
+		current.publish_static_part(part,parent)
+		var position: Vector3 = parent.global_transform*part.position
+		owners[part.id] = Vector2i(floori(position.x/43.2),floori(position.z/43.2))
+		expected[part.id] = []
+		for key in old.static_visual_batches:
+			var group: Dictionary = old.static_visual_batches[key]
+			for i in range(before.get(key,0),group.transforms.size()):
+				expected[part.id].append([group.transforms[i],group.customData[i],old.material_cache.find_key(group.material)])
+	var group_cells: Dictionary = {}
+	for group in current.static_visual_batches.values(): group_cells[group.ownerCell]=true
+	check("spatial_separate_world_cells",group_cells.size()==3)
+	current._begin_static_flush(parent,false)
+	while current.has_pending_static_flush(): current.advance_static_flush(parent,2500)
+	var actual: Dictionary = {}
+	var ownership := true
+	var bounds_exact := true
+	var spans_frozen := true
+	for node in current.published_nodes:
+		if not node is MultiMeshInstance3D: continue
+		var spans: Array = node.get_meta("building_instance_sources")
+		spans_frozen = spans_frozen and spans.is_read_only()
+		var covered := 0
+		for span: Dictionary in spans:
+			spans_frozen = spans_frozen and span.is_read_only()
+			ownership = ownership and node.get_meta("building_spatial_cell")==owners.get(span.partId) and span.first==covered
+			if not actual.has(span.partId): actual[span.partId]=[]
+			for i in range(span.first,span.first+span.count):
+				var pose: Transform3D = node.multimesh.submissions[i*2][2]
+				actual[span.partId].append([pose,node.multimesh.submissions[i*2+1][2],current.material_cache.find_key(node.material_override)])
+				bounds_exact = bounds_exact and node.multimesh.custom_aabb.grow(0.0001).encloses(pose*AABB(Vector3(-0.5,-0.5,-0.5),Vector3.ONE))
+			covered += span.count
+		ownership = ownership and covered==node.multimesh.instance_count
+	check("spatial_crossing_parts_single_owner",ownership and actual.size()==3)
+	check("spatial_complete_instance_source_spans",spans_frozen and ownership)
+	check("spatial_bounds_cover_cross_cell_geometry",bounds_exact)
+	var exact := actual.size()==expected.size()
+	for id in expected: exact = exact and var_to_bytes(actual.get(id,[]))==var_to_bytes(expected[id])
+	check("spatial_original_geometry_material_custom_exact",exact)
+	check("spatial_collision_not_duplicated",current.collision_count==3 and current.static_collision_body.get_child_count()==3)
+	parent.free(); old_parent.free()
+	current.published_nodes=[]; current.static_collision_body=null
+	old.published_nodes=[]; old.static_collision_body=null
+
+func spatial_partial_flush() -> void:
+	var parent := Node3D.new(); root.add_child(parent)
+	var publisher := RecordingPublisher.new()
+	publisher.resumable_scene_publication=true
+	var blueprint := Blueprint.new("spatial-partial",2)
+	for x in [0.0,100.0,2.0]:
+		blueprint.add_part({"id":"part_"+str(blueprint.parts.size()),"kind":"beam","material":"wood",
+			"position":Vector3(x,0,0),"size":Vector3(1,0.3,0.3)})
+	publisher._spatial_completion=Publisher.SpatialGroups.completion_index(blueprint,Transform3D.IDENTITY)
+	publisher.incremental_total_parts=3
+	publisher.publish_static_part(blueprint.parts[0],parent)
+	publisher.incremental_published_parts=1
+	publisher._begin_static_flush(parent,true)
+	check("spatial_pending_cell_retains_demand",not publisher.has_pending_static_flush() and not publisher.static_visual_batches.is_empty())
